# Envoi du formulaire de contact (optionnel), lu par le Worker (worker/contact.ts).
# À définir dans Cloudflare (Worker > Settings > Variables and Secrets) ; en local, dans .dev.vars.
# Tant que ces trois variables ne sont pas définies, /api/contact répond 501
# et le site affiche honnêtement que l'envoi n'est pas configuré.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# URL publique du site (canonicals, sitemap, robots, Open Graph, JSON-LD), ex. https://example.com
# Obligatoire pour le build de production (sinon le build échoue) ; localhost en dev.
# Valeur de production versionnée dans .env.production.
NEXT_PUBLIC_SITE_URL=
