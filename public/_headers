# En-têtes des fichiers statiques Cloudflare (copié tel quel dans out/ au build).
# Les icônes et images Open Graph générées par Next sont exportées sans extension :
# forcer leur type pour que navigateurs et réseaux sociaux les reconnaissent.
/icon
  Content-Type: image/png
/apple-icon
  Content-Type: image/png
/opengraph-image
  Content-Type: image/png
/projets/*/opengraph-image
  Content-Type: image/png
