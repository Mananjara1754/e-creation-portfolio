// Cloudflare Workers Builds : build `npm run build`, puis `npx wrangler deploy` (main) ou `npx wrangler preview` (branches).
{
  "name": "e-creation-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Le site n'est servi que sur ecreation-mg.com (pas de copie sur *.workers.dev) ;
  // les URL de prévisualisation des branches restent actives.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // Limite d'envois du formulaire par IP, gérée par Cloudflare (worker/contact.ts).
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
  ],
  // Requis par `wrangler preview` (versions de prévisualisation des branches).
  "previews": {},
}
